{"document_id":"cir-madecassoside-safety-assessment-v1","title":"Madecassoside — CIR (Centella) safety-assessment factual card","source":"Cosmetic Ingredient Review (CIR)","source_family":"CIR","source_url":"https://journals.sagepub.com/doi/full/10.1177/10915818231158272","published_year":2023,"document_type":"regulatory-safety-provenance-card","evidence_tier":"regulatory-safety-provenance","chunk_text":"Paraphrased CIR conclusion: the CIR Safety Assessment of Centella asiatica-Derived Ingredients (2023) addressed the Centella triterpenoid constituents, including Madecassoside, and concluded the assessed ingredients are safe in the present practices of use and concentration when formulated to be non-sensitising. Paraphrased factual summary; no verbatim CIR text is stored.","source_locator":"Safety Assessment of Centella asiatica-Derived Ingredients as Used in Cosmetics (CIR, 2023) — triterpenoid constituents.","citation_text":"Cosmetic Ingredient Review. Safety Assessment of Centella asiatica-Derived Ingredients as Used in Cosmetics. Int J Toxicol. 2023.","claim_category":"ingredient-regulatory-safety-context","clinical_review_status":"pending: qualified review must reconfirm constituent listing before activation.","reuse_rights_status":"attribution_only","reuse_rights_basis":"Factual paraphrase with attribution and source link; protected expression not reproduced.","verification_status":"verified_paraphrase","verified_by":"web-search-assisted draft — reviewer must reconfirm constituent listing","verified_at":"2026-07-27","product_specific":false,"attribution_required":true,"routine_selection_allowed":false,"ingredient_ids":["madecassoside"],"ingredient_names":["Madecassoside"],"inci_names":["Madecassoside"]}
