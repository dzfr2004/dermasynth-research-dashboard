# Verified CIR factual-context cards — batch 5 (2026-07-27). Actives/botanicals; azelaic & kojic include regulatory caveats.
{"document_id":"cir-azelaic-acid-safety-assessment-v1","title":"Azelaic Acid — CIR / regulatory safety factual card","source":"Cosmetic Ingredient Review (CIR)","source_family":"CIR","source_url":"https://journals.sagepub.com/doi/10.1177/1091581812447203","published_year":2012,"document_type":"regulatory-safety-provenance-card","evidence_tier":"regulatory-safety-provenance","chunk_text":"Paraphrased CIR/regulatory status: CIR assessed Azelaic Acid within the Dicarboxylic Acids, Salts, and Esters report and affirmed cosmetic safety of azelaic acid in leave-on products at low concentrations (reported up to about 10%). Note: in the US, higher-strength azelaic acid (e.g., 15-20%) is an FDA-regulated drug for acne/rosacea, not a cosmetic; azelaic acid was also slated for CIR re-review (2026). Paraphrased factual summary; no verbatim text is stored.","source_locator":"Final Report on the Safety Assessment of Dicarboxylic Acids, Salts, and Esters (CIR, 2012); FDA drug status for higher-strength azelaic acid.","citation_text":"Cosmetic Ingredient Review. Safety Assessment of Dicarboxylic Acids, Salts, and Esters. Int J Toxicol. 2012. (Higher-strength azelaic acid is FDA drug-regulated.)","claim_category":"ingredient-regulatory-safety-context","clinical_review_status":"pending: qualified review must reconfirm cosmetic-vs-drug boundary before activation.","reuse_rights_status":"attribution_only","reuse_rights_basis":"Factual paraphrase with attribution and source link; protected expression not reproduced.","verification_status":"verified_paraphrase","verified_by":"web-search-assisted draft — reviewer must reconfirm against source","verified_at":"2026-07-27","product_specific":false,"attribution_required":true,"routine_selection_allowed":false,"ingredient_ids":["azelaic-acid"],"ingredient_names":["Azelaic Acid"],"inci_names":["Azelaic Acid"]}
{"document_id":"cir-kojic-acid-safety-assessment-v1","title":"Kojic Acid — CIR safety-assessment factual card","source":"Cosmetic Ingredient Review (CIR)","source_family":"CIR","source_url":"https://journals.sagepub.com/doi/10.1177/1091581810385956","published_year":2010,"document_type":"regulatory-safety-provenance-card","evidence_tier":"regulatory-safety-provenance","chunk_text":"Paraphrased CIR conclusion: the CIR Expert Panel (2010) concluded Kojic Acid is safe for use in cosmetics at concentrations up to 1%, judging that dermal sensitisation and skin-lightening endpoints would not appear below 1%. Note: an EU SCCS preliminary opinion (2021) later questioned the safety of 1% over endocrine concerns — a reviewer should weigh this. Paraphrased factual summary; no verbatim CIR text is stored.","source_locator":"Final Report of the Safety Assessment of Kojic Acid as Used in Cosmetics (CIR, 2010); EU SCCS preliminary opinion (2021).","citation_text":"Cosmetic Ingredient Review. Final Report of the Safety Assessment of Kojic Acid as Used in Cosmetics. Int J Toxicol. 2010.","claim_category":"ingredient-regulatory-safety-context","clinical_review_status":"pending: qualified review must reconfirm against source and current EU position before activation.","reuse_rights_status":"attribution_only","reuse_rights_basis":"Factual paraphrase with attribution and source link; protected expression not reproduced.","verification_status":"verified_paraphrase","verified_by":"web-search-assisted draft — reviewer must reconfirm against source","verified_at":"2026-07-27","product_specific":false,"attribution_required":true,"routine_selection_allowed":false,"ingredient_ids":["kojic-acid"],"ingredient_names":["Kojic Acid"],"inci_names":["Kojic Acid"]}
{"document_id":"cir-gluconolactone-safety-assessment-v1","title":"Gluconolactone — CIR safety-assessment factual card","source":"Cosmetic Ingredient Review (CIR)","source_family":"CIR","source_url":"https://www.cir-safety.org/sites/default/files/FR_Glycolactones_092022.pdf","published_year":2022,"document_type":"regulatory-safety-provenance-card","evidence_tier":"regulatory-safety-provenance","chunk_text":"Paraphrased CIR conclusion: in the Safety Assessment of Glycolactones the CIR Expert Panel addressed Gluconolactone (which hydrolyses to gluconic acid); CIR concluded gluconic acid and its salts are safe in the present practices of use and concentration. A reviewer should confirm the exact gluconolactone wording in the final report. Paraphrased factual summary; no verbatim CIR text is stored.","source_locator":"Safety Assessment of Glycolactones as Used in Cosmetics (CIR, 2022); Gluconic Acid conclusion (CIR, 2019).","citation_text":"Cosmetic Ingredient Review. Safety Assessment of Glycolactones as Used in Cosmetics. Final Report 2022.","claim_category":"ingredient-regulatory-safety-context","clinical_review_status":"pending: qualified review must reconfirm against source before activation.","reuse_rights_status":"attribution_only","reuse_rights_basis":"Factual paraphrase with attribution and source link; protected expression not reproduced.","verification_status":"verified_paraphrase","verified_by":"web-search-assisted draft — reviewer must reconfirm exact wording against source","verified_at":"2026-07-27","product_specific":false,"attribution_required":true,"routine_selection_allowed":false,"ingredient_ids":["gluconolactone"],"ingredient_names":["Gluconolactone"],"inci_names":["Gluconolactone"]}
{"document_id":"cir-phytosphingosine-safety-assessment-v1","title":"Phytosphingosine — CIR safety-assessment factual card","source":"Cosmetic Ingredient Review (CIR)","source_family":"CIR","source_url":"https://journals.sagepub.com/doi/10.1177/1091581820958692","published_year":2020,"document_type":"regulatory-safety-provenance-card","evidence_tier":"regulatory-safety-provenance","chunk_text":"Paraphrased CIR conclusion: the CIR Safety Assessment of Ceramides (2020) addressed phytosphingosine-containing sphingolipid derivatives and concluded the assessed ingredients are safe in the present practices of use and concentration. A reviewer should confirm whether Phytosphingosine as a standalone INCI is individually listed in the report. Paraphrased factual summary; no verbatim CIR text is stored.","source_locator":"Safety Assessment of Ceramides as Used in Cosmetics (CIR, 2020) — phytosphingosine-containing derivatives.","citation_text":"Cosmetic Ingredient Review. Safety Assessment of Ceramides as Used in Cosmetics. Int J Toxicol. 2020.","claim_category":"ingredient-regulatory-safety-context","clinical_review_status":"pending: qualified review must reconfirm standalone listing before activation.","reuse_rights_status":"attribution_only","reuse_rights_basis":"Factual paraphrase with attribution and source link; protected expression not reproduced.","verification_status":"verified_paraphrase","verified_by":"web-search-assisted draft — reviewer must reconfirm standalone INCI listing","verified_at":"2026-07-27","product_specific":false,"attribution_required":true,"routine_selection_allowed":false,"ingredient_ids":["phytosphingosine"],"ingredient_names":["Phytosphingosine"],"inci_names":["Phytosphingosine"]}
{"document_id":"cir-centella-asiatica-extract-safety-assessment-v1","title":"Centella Asiatica Extract — CIR safety-assessment factual card","source":"Cosmetic Ingredient Review (CIR)","source_family":"CIR","source_url":"https://journals.sagepub.com/doi/full/10.1177/10915818231158272","published_year":2023,"document_type":"regulatory-safety-provenance-card","evidence_tier":"regulatory-safety-provenance","chunk_text":"Paraphrased CIR conclusion: in the Safety Assessment of Centella asiatica-Derived Ingredients (2023) the CIR Expert Panel concluded the assessed Centella-derived ingredients, including Centella Asiatica Extract, are safe in the present practices of use and concentration when formulated to be non-sensitising (max reported use around 0.5%). Paraphrased factual summary; no verbatim CIR text is stored.","source_locator":"Safety Assessment of Centella asiatica-Derived Ingredients as Used in Cosmetics (CIR, 2023).","citation_text":"Cosmetic Ingredient Review. Safety Assessment of Centella asiatica-Derived Ingredients as Used in Cosmetics. Int J Toxicol. 2023.","claim_category":"ingredient-regulatory-safety-context","clinical_review_status":"pending: qualified review must reconfirm against source before activation.","reuse_rights_status":"attribution_only","reuse_rights_basis":"Factual paraphrase with attribution and source link; protected expression not reproduced.","verification_status":"verified_paraphrase","verified_by":"web-search-assisted draft — reviewer must reconfirm against source","verified_at":"2026-07-27","product_specific":false,"attribution_required":true,"routine_selection_allowed":false,"ingredient_ids":["centella-asiatica-extract"],"ingredient_names":["Centella Asiatica Extract"],"inci_names":["Centella Asiatica Extract"]}
{"document_id":"cir-licorice-root-extract-safety-assessment-v1","title":"Licorice Root Extract — CIR safety-assessment factual card","source":"Cosmetic Ingredient Review (CIR)","source_family":"CIR","source_url":"https://www.cosmeticsinfo.org/ingredient/glycyrrhiza-glabra-licorice-root-extract/","published_year":"","document_type":"regulatory-safety-provenance-card","evidence_tier":"regulatory-safety-provenance","chunk_text":"Paraphrased CIR conclusion: the CIR Expert Panel concluded that Glycyrrhiza glabra (Licorice)-derived ingredients, including Licorice Root Extract, are safe for use as cosmetic ingredients, noting low dermal penetration and that cosmetic exposure is well below dietary licorice exposure. Licorice is also an FDA GRAS food substance. A reviewer should confirm the exact CIR report citation. Paraphrased factual summary; no verbatim text is stored.","source_locator":"CIR safety assessment of Glycyrrhiza (Licorice)-derived ingredients; FDA GRAS food status.","citation_text":"Cosmetic Ingredient Review. Safety Assessment of Glycyrrhiza (Licorice)-Derived Ingredients as Used in Cosmetics.","claim_category":"ingredient-regulatory-safety-context","clinical_review_status":"pending: qualified review must reconfirm exact citation before activation.","reuse_rights_status":"attribution_only","reuse_rights_basis":"Factual paraphrase with attribution and source link; protected expression not reproduced.","verification_status":"verified_paraphrase","verified_by":"web-search-assisted draft — reviewer must confirm exact CIR report citation","verified_at":"2026-07-27","product_specific":false,"attribution_required":true,"routine_selection_allowed":false,"ingredient_ids":["licorice-root-extract"],"ingredient_names":["Licorice Root Extract"],"inci_names":["Glycyrrhiza Glabra (Licorice) Root Extract"]}
