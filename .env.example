# Keep this file safe to share. Put real values only in .env (already ignored).
# Set to true only when you are ready for browser actions to call external APIs.
LIVE_SERVICES_ENABLED=false

# Opt in only after your project approval record is complete. This enables
# evidence-linked named research candidates beneath already-safe categories;
# it never changes the category-only AM/PM routine steps.
INGREDIENT_SELECTION_ENABLED=false

# Dynamic knowledge base. When true, the Atlas / knowledge-explorer read from
# the versioned SQLite database (data/db/dermasynth.sqlite) instead of the
# static JSON files, and the token-protected /api/admin workflow is active.
# Run `npm run db:migrate` then `npm run db:seed` first.
INGREDIENT_DB_ENABLED=false
# Optional: override the database file location (defaults to data/db/dermasynth.sqlite).
INGREDIENT_DB_PATH=

# Local-only administration for the runtime policy registry AND the dynamic
# knowledge-base admin workflow (/api/admin/*). Set a unique 24+ character
# token before using POST /api/governance/policy or /api/admin routes.
GOVERNANCE_ADMIN_TOKEN=

OPENAI_API_KEY=
# The backend uses the Responses API with structured output.
OPENAI_MODEL=gpt-5.6-sol
# This short schema-formatting task uses no extended reasoning by default.
OPENAI_REASONING_EFFORT=none

OPENWEATHER_API_KEY=
IQAIR_API_KEY=

PINECONE_API_KEY=
PINECONE_INDEX=
# Optional: otherwise the backend resolves the index host through Pinecone's control plane.
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=__default__
# Separate non-clinical final-review knowledge atlas namespace. It is never
# used as a named-ingredient routine selector.
PINECONE_RESEARCH_NAMESPACE=demo-atlas-50-v1
# Ingredient evidence documents searched by the candidate-pool retriever
# (dense half of the hybrid). Populate with: npm run sync:evidence-pinecone -- --upload
PINECONE_EVIDENCE_NAMESPACE=demo-ingredient-evidence-v2
# Change these only when your index uses different record field names.
PINECONE_TEXT_FIELD=chunk_text
PINECONE_TITLE_FIELD=title
PINECONE_SOURCE_FIELD=source
PINECONE_UPSERT_BATCH_SIZE=50

# Provider calls are cached server-side; no values are sent to the browser as credentials.
ENVIRONMENT_CACHE_SECONDS=600
IQAIR_CACHE_SECONDS=1800
LOCATION_SEARCH_CACHE_SECONDS=900
SERVICE_TIMEOUT_MS=9000
# Context Utilisation Evaluation: share of the model's statements that are
# supported by the context it was given. Below the threshold the text is
# regenerated CUE_MAX_RETRIES time(s), then withheld.
CUE_THRESHOLD=0.80
# llm_judge = the model checks each statement against the context (one extra
# call per rationale, falls back to lexical on error); lexical = no extra call.
CUE_METHOD=llm_judge
CUE_MAX_RETRIES=1

# Append-only JSONL log of every ingredient selection (pool, model pick,
# fallbacks, safety removals, CUE). Summarise with npm run report:selection-log
SELECTION_LOG_ENABLED=true
SELECTION_LOG_PATH=data/logs/selection-log.jsonl

# Optional local reviewer workflow. Disabled by default and refused when
# NODE_ENV=production. Use a generated secret of at least 24 characters; do
# not put it in frontend code or share it in screenshots/exports.
REVIEWER_QUEUE_ENABLED=false
REVIEWER_QUEUE_TOKEN=
