    "test": "npm run check && npm run verify:ingredient-kb && npm run verify:demo-kb && npm run eval:study && npm run eval:retrieval && npm run eval:safety-50 && npm run eval:ingredient-selection && npm run eval:category-coverage && npm run eval:triage && npm run eval:safety-extended",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:seed": "node scripts/seed-ingredient-db.mjs --fresh",
    "db:seed-approved": "node scripts/seed-ingredient-db.mjs --fresh --state approved",
    "db:promote-signedoff": "node scripts/promote-signedoff-corpus.mjs",
    "db:publish-atlas": "node scripts/publish-approved-ingredient-db.mjs",
    "db:reindex-approved": "node scripts/reindex-approved-knowledge-base.mjs",
    "data:environmental-training": "node scripts/generate-environmental-training.mjs",
    "data:cir-ewg-cards": "node scripts/generate-cir-ewg-cards.mjs",
    "fit:environmental-model": "node scripts/fit-environmental-surrogate.mjs",
    "fit:environmental-default": "node scripts/generate-environmental-training.mjs && node scripts/fit-environmental-surrogate.mjs data/models/environmental-context-training.v1.csv",
    "verify:ingredient-db": "node scripts/verify-ingredient-db.mjs",
    "verify:index": "node scripts/verify-pinecone.mjs",
    "verify:ingredient-kb": "node scripts/verify-ingredient-knowledge.mjs",
    "verify:demo-kb": "node scripts/verify-demo-ingredient-kb.mjs",
    "sync:atlas-pinecone": "node scripts/sync-atlas-research.mjs",
    "verify:demo-pinecone": "node scripts/verify-demo-pinecone.mjs",
    "verify:category-coverage": "node scripts/verify-category-coverage-pinecone.mjs",
    "ingest:evidence": "node scripts/ingest-evidence.mjs",
    "eval:evidence-rights": "node scripts/evaluate-evidence-rights.mjs",
    "eval:safety": "node scripts/evaluate-safety.mjs",
    "eval:location": "node scripts/evaluate-location.mjs",
    "eval:study": "node scripts/evaluate-study.mjs",
    "eval:retrieval": "node scripts/evaluate-retrieval.mjs",
    "eval:safety-50": "node scripts/evaluate-safety-50.mjs",
    "eval:ingredient-selection": "node scripts/evaluate-ingredient-selection.mjs",
    "eval:category-coverage": "node scripts/evaluate-category-coverage.mjs",
    "eval:uat": "node scripts/score-uat.mjs",
    "eval:inter-rater": "node scripts/score-inter-rater.mjs",
    "check:openai": "node scripts/check-openai.mjs",
    "labelling:sheet": "node scripts/generate-labelling-sheet.mjs",
    "labelling:import": "node scripts/import-expert-labels.mjs",
    "fit:environmental-expert": "node scripts/fit-environmental-surrogate.mjs data/models/environmental-context-training.expert.v1.csv --source expert",
    "report:selection-log": "node scripts/report-selection-log.mjs",
    "report:corpus-inventory": "node scripts/corpus-inventory.mjs",
    "db:apply-kb-update": "node scripts/apply-kb-update-2026-09.mjs",
    "sync:evidence-pinecone": "node scripts/sync-ingredient-evidence-pinecone.mjs",
    "eval:input-sensitivity": "node scripts/evaluate-input-sensitivity.mjs",
    "eval:triage": "node scripts/evaluate-triage.mjs",
    "eval:safety-extended": "node scripts/evaluate-safety-extended.mjs",
    "eval:independent": "node scripts/evaluate-independent-safety.mjs"
